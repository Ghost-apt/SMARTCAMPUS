# ==========================================
# SmartCampus AI — Backend Environment Configuration
# Copy this file to .env and configure for your environment.
# NEVER commit the actual .env file with secrets to Git.
# ==========================================

# Application Port (Default: 5000)
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
# Development Local: mongodb://127.0.0.1:27017/smartcampus
# Docker Compose:    mongodb://mongodb:27017/smartcampus
# Production Atlas:  mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/smartcampus?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartcampus

# JSON Web Token Configuration
# Minimum 32 characters in production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin for CORS
# Development: http://localhost:5173
# Production:  https://smartcampus.youruniversity.edu
CLIENT_ORIGIN=http://localhost:5173

# Python AI & RAG Microservice URL
# Development: http://127.0.0.1:8000
# Docker:      http://ai-service:8000
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared Secret Key for Inter-Service Authentication (Backend <-> AI Microservice)
INTERNAL_AI_KEY=your_shared_internal_ai_secret_key_here
