# ==========================================
# SmartCampus AI — Client Environment Configuration
# Copy this file to .env and configure for your environment.
# ==========================================

# Backend REST API Base URL
# Development & Production: /api (proxied via Vite dev server or Nginx reverse proxy)
# Standalone remote API: https://api.smartcampus.youruniversity.edu/api
VITE_API_BASE_URL=/api
# Razorpay Public Key ID (Safe for frontend exposure, starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
